<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dsh_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dsh_bg">

    <FrameLayout
        android:id="@+id/dsh_web_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <WebView
            android:id="@+id/dsh_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/dsh_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="top"
            android:max="100"
            android:progressBackgroundTint="@android:color/transparent"
            android:progressTint="@color/dsh_accent" />

        <ImageButton
            android:id="@+id/dsh_btn_menu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="14dp"
            android:background="@drawable/dsh_bg_fab"
            android:contentDescription="菜单"
            android:scaleType="centerInside"
            android:src="@drawable/dsh_ic_more"
            android:tint="@color/dsh_text" />
    </FrameLayout>

    <ScrollView
        android:id="@+id/dsh_setup_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="52dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DSH Mobile"
                android:textColor="@color/dsh_text"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="内置 Termux · 插件全支持"
                android:textColor="@color/dsh_muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/dsh_btn_start"
                style="@style/DshButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="40dp"
                android:enabled="false"
                android:text="一键启动"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/dsh_progress_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressBackgroundTint="@color/dsh_surface2"
                    android:progressTint="@color/dsh_accent" />

                <TextView
                    android:id="@+id/dsh_percent"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0%"
                    android:textColor="@color/dsh_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/dsh_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:minHeight="48dp"
                android:textColor="@color/dsh_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/dsh_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/dsh_bg_input"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:maxLines="6"
                android:padding="10dp"
                android:textColor="@color/dsh_muted"
                android:textSize="11sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/dsh_btn_terminal"
                    style="@style/DshButton.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="打开终端" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/dsh_btn_manual"
                    style="@style/DshButton.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="手动配置" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dsh_manual_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/DshLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="服务地址" />

                <EditText
                    android:id="@+id/dsh_input_base_url"
                    style="@style/DshInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="http://127.0.0.1:3090"
                    android:inputType="textUri" />

                <TextView
                    style="@style/DshLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="授权令牌 / 完整 URL" />

                <EditText
                    android:id="@+id/dsh_input_token"
                    style="@style/DshInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="粘贴 dsh web 打印的 URL"
                    android:inputType="textUri" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/dsh_btn_paste"
                        style="@style/DshButton.Ghost"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="粘贴" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/dsh_btn_connect"
                        style="@style/DshButton.Primary"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="连接" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/dsh_btn_help"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="使用说明"
                android:textColor="@color/dsh_accent"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
