<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.DshMobile" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/dsh_accent</item>
        <item name="colorPrimaryDark">@color/dsh_bg</item>
        <item name="colorAccent">@color/dsh_accent</item>
        <item name="android:windowBackground">@color/dsh_bg</item>
        <item name="android:statusBarColor">@color/dsh_bg</item>
        <item name="android:navigationBarColor">@color/dsh_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/dsh_text</item>
        <item name="android:textColorSecondary">@color/dsh_muted</item>
        <item name="alertDialogTheme">@style/Theme.DshMobile.Dialog</item>
    </style>

    <style name="Theme.DshMobile.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@color/dsh_surface</item>
        <item name="android:textColorPrimary">@color/dsh_text</item>
        <item name="colorAccent">@color/dsh_accent</item>
    </style>

    <style name="DshButton" parent="Widget.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/dsh_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <style name="DshButton.Primary" parent="DshButton">
        <item name="android:background">@drawable/dsh_bg_btn_primary</item>
        <item name="android:textColor">@color/dsh_white</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="DshButton.Ghost" parent="DshButton">
        <item name="android:background">@drawable/dsh_bg_btn_ghost</item>
    </style>

    <style name="DshInput" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/dsh_bg_input</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">13dp</item>
        <item name="android:paddingBottom">13dp</item>
        <item name="android:textColor">@color/dsh_text</item>
        <item name="android:textColorHint">@color/dsh_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <style name="DshLabel" parent="">
        <item name="android:textColor">@color/dsh_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

</resources>
