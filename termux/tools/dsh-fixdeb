#!/data/data/com.dshapp/files/usr/bin/bash
#
# dsh-fixdeb —— apt 的 DPkg::Pre-Invoke 钩子。
#
# 在 dpkg 真正安装之前，把 apt 缓存里的每个 .deb 改写成适配 com.dshapp 的包：
#   1. 解包（dpkg-deb -R）
#   2. 把包内路径 data/data/com.termux 改名为 data/data/com.dshapp
#   3. 把文件内容里的 com.termux 就地改写为 com.dshapp（等长，二进制安全）
#   4. 丢弃 md5sums（内容已变，保留会误导 dpkg --verify）
#   5. 重新打包
#
# 必须在「安装前」做：dpkg 会直接 execve 执行 preinst/postinst，若 shebang 仍指向
# /data/data/com.termux/... 就会 ENOENT，安装直接失败。
#
# 性能要点：
#   * 重打包用 gzip -1 而不是 xz。实测 nodejs 包 xz -6 要 45.8s，gzip -1 只要 1.3s。
#   * 没有实际改动（既没改名也没改写任何文件）时直接跳过重打包，用原包。
#
# 失败处理（重要）：
#   改写失败时**必须删掉这个 .deb**。否则 dpkg 会拿到未改写前缀的原包，
#   往 /data/data/com.termux/ 写而失败，报出一堆看不懂的
#   "Errors were encountered while processing: .../xxx.deb"。
#   删掉后 apt 会明确报"找不到包"，日志里也能看到具体原因。
set -u

PREFIX=/data/data/com.dshapp/files/usr
CACHE="$PREFIX/var/cache/apt/archives"
FIXER="$PREFIX/bin/dshfix"
LOG="$PREFIX/tmp/dsh-fixdeb.log"

[ -x "$FIXER" ] || exit 0
[ -d "$CACHE" ] || exit 0

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG" 2>/dev/null; }

# 剩余空间（KB）。磁盘不足是重打包失败最常见的原因。
free_kb() {
    local line
    line=$(df -Pk "$PREFIX" 2>/dev/null | tail -1)
    # shellcheck disable=SC2086
    set -- $line
    echo "${4:-0}"
}

log "hook start, free=$(free_kb)KB"

shopt -s nullglob
for deb in "$CACHE"/*.deb; do
    name="${deb##*/}"
    work="$PREFIX/tmp/dshdeb.$$"
    rm -rf "$work"
    mkdir -p "$work" || continue

    t0=$(date +%s%N 2>/dev/null || echo 0)

    if ! dpkg-deb -R "$deb" "$work" 2>>"$LOG"; then
        log "EXTRACT FAILED, dropping unpatched package: $name"
        rm -rf "$work"
        rm -f "$deb"
        continue
    fi

    renamed=0
    if [ -d "$work/data/data/com.termux" ]; then
        mv "$work/data/data/com.termux" "$work/data/data/com.dshapp" 2>/dev/null && renamed=1
    fi

    fixed=$("$FIXER" "$work" 2>/dev/null | sed -n 's/.*: \([0-9][0-9]*\) file.*/\1/p')
    fixed=${fixed:-0}

    if [ "$renamed" = "0" ] && [ "$fixed" = "0" ]; then
        log "unchanged, kept original: $name"
        rm -rf "$work"
        continue
    fi

    rm -f "$work/DEBIAN/md5sums"
    # dpkg-deb -R 解出的维护脚本可能丢失可执行位，重新打包前补回
    chmod 755 "$work"/DEBIAN/preinst "$work"/DEBIAN/postinst \
              "$work"/DEBIAN/prerm "$work"/DEBIAN/postrm 2>/dev/null

    # 依次降级：带 root-owner-group → 不带 → 默认压缩。
    # 某些 dpkg 版本或特殊包（带版本号 .so 符号链接的库）会在某一步失败。
    ok=0
    if dpkg-deb -b -Zgzip -z1 --root-owner-group "$work" "$deb.new" 2>>"$LOG"; then
        ok=1
    elif dpkg-deb -b -Zgzip -z1 "$work" "$deb.new" 2>>"$LOG"; then
        ok=1
    elif dpkg-deb -b "$work" "$deb.new" 2>>"$LOG"; then
        ok=1
    fi

    if [ "$ok" = "1" ]; then
        mv -f "$deb.new" "$deb" 2>/dev/null || rm -f "$deb.new"
        t1=$(date +%s%N 2>/dev/null || echo 0)
        log "rewritten in $(( (t1 - t0) / 1000000 ))ms, $fixed files, free=$(free_kb)KB: $name"
    else
        rm -f "$deb.new"
        log "REPACK FAILED, dropping unpatched package: $name (free=$(free_kb)KB)"
        rm -f "$deb"
    fi
    rm -rf "$work"
done

log "hook done, free=$(free_kb)KB"
exit 0
