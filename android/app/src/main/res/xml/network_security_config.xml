<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- DSH 主机通常跑在本机 Termux 的 http://127.0.0.1:3090，需要允许明文回环流量。 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
